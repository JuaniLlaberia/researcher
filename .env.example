# PostgreSQL configuration
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_HOST=""
POSTGRES_PORT=0

# LLM configuration
LLM_PROVIDER=""
LLM_MODEL=""
LLM_TEMPERATURE=0.0

# LLMs keys (Only selected provider key is needed)
ANTHROPIC_API_KEY=""
