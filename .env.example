# Optional
SEMANTIC_SCHOLAR_API_KEY=""

# Embedder configuration
EMBEDDER_PROVIDER=""
EMBEDDER_MODEL=""
# Must match the embedder's output dimension and the Vector(N) column on PaperChunk.
EMBEDDING_DIM=768
